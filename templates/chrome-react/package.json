{
  "name": "appforge-chrome-react-template",
  "version": "0.1.0",
  "private": true,
  "description": "AppForge AI Chrome MV3 template: a popup + options extension using React, wired to @appforge/{storage,messaging,errors,flags}. Use this when a product needs real UI components (see cors-enabler for the shape this fits).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@appforge/errors": "workspace:*",
    "@appforge/flags": "workspace:*",
    "@appforge/messaging": "workspace:*",
    "@appforge/storage": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/chrome": "^0.0.279",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.0"
  }
}
