{
  "name": "appforge-kit",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm run build",
    "test": "vitest run && pnpm --filter @appforge/edge test",
    "pretypecheck": "pnpm run build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
